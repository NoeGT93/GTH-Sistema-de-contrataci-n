# PostgreSQL 16
DATABASE_URL="postgresql://usuario:clave@host:5432/fundap"

# Auth.js — opcional: si falta se deriva de DATABASE_URL. Para fijarlo: npx auth secret
AUTH_SECRET=""

# Acceso por enlace al correo: siempre activo (usa RESEND_API_KEY, abajo).
# Opcional: Google Workspace o Microsoft 365 como botones extra.
# Google Workspace
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Microsoft 365 / Entra ID
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""   # https://login.microsoftonline.com/<tenant-id>/v2.0

# Solo desarrollo local: entrar con el correo de un usuario existente (ignorado en producción).
AUTH_DEV_LOGIN="false"

# Vercel Cron firma sus llamadas con este secreto.
CRON_SECRET=""

# Primer superadmin que crea `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""

# Archivos (CV): bucket S3 privado. Sin S3_BUCKET, en desarrollo se guardan en .uploads/.
S3_BUCKET=""
S3_REGION="us-east-1"
# Credenciales con las variables estándar de AWS (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY).
# El bucket necesita CORS que permita PUT desde el dominio del portal.

# Correo (Resend). Sin API key, los correos (y enlaces de acceso) se imprimen en consola / logs.
RESEND_API_KEY=""
# Opcional: requiere dominio verificado en Resend. Por defecto onboarding@resend.dev.
EMAIL_FROM=""
# Opcional: por defecto el dominio de producción de Vercel.
SITE_URL=""
