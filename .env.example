# PostgreSQL 16
DATABASE_URL="postgresql://usuario:clave@host:5432/fundap"

# Auth.js — genera con: npx auth secret
AUTH_SECRET=""

# Proveedor de inicio de sesión (pendiente de decisión): llena UNO de los dos bloques.
# Google Workspace
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Microsoft 365 / Entra ID
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""   # https://login.microsoftonline.com/<tenant-id>/v2.0

# Solo desarrollo local: entrar con el correo de un usuario existente (ignorado en producción).
AUTH_DEV_LOGIN="false"

# Vercel Cron firma sus llamadas con este secreto.
CRON_SECRET=""

# Primer superadmin que crea `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
